{
  "name": "canonical",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
    "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS -g './config/git/commitlint.cjs'"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "cz-customizable": "^7.5.1",
    "husky": "^9.1.7",
    "vite": "^6.0.5"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "config/git/commitizen.cjs"
    }
  }
}
